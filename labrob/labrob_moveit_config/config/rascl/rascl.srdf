<?xml version="1.0" encoding="UTF-8"?>
<robot name="rascl">
    <group name="arm">
        <joint name="shoulder_joint" />
        <joint name="upper_arm_joint" />
        <joint name="lower_arm_joint" />
    </group>

    <group name="gripper">
        <link name="gripper_base_link" />
        <link name="pinion_gear" />
        <link name="right_jaw" />
        <link name="left_jaw" />
        <joint name="pinion_joint" />
        <joint name="right_jaw_joint" />
        <joint name="left_jaw_joint" />
    </group>

    <group_state name="home" group="arm">
        <joint name="shoulder_joint" value="0" />
        <joint name="upper_arm_joint" value="0" />
        <joint name="lower_arm_joint" value="0" />
    </group_state>

    <group_state name="open" group="gripper">
        <joint name="pinion_joint" value="0.5" />
    </group_state>
    <group_state name="close" group="gripper">
        <joint name="pinion_joint" value="-0.5" />
    </group_state>

    <end_effector name="gripper_ee" parent_link="lower_arm" group="gripper" parent_group="arm" />

    <disable_collisions link1="base_link" link2="shoulder" reason="Adjacent" />
    <disable_collisions link1="shoulder" link2="upper_arm" reason="Adjacent" />
    <disable_collisions link1="upper_arm" link2="lower_arm" reason="Adjacent" />
    <disable_collisions link1="lower_arm" link2="gripper_base_link" reason="Adjacent" />
    
    <disable_collisions link1="gripper_base_link" link2="pinion_gear" reason="Adjacent" />
    <disable_collisions link1="gripper_base_link" link2="right_jaw" reason="Adjacent" />
    <disable_collisions link1="gripper_base_link" link2="left_jaw" reason="Adjacent" />
    <disable_collisions link1="pinion_gear" link2="right_jaw" reason="Never" />
    <disable_collisions link1="pinion_gear" link2="left_jaw" reason="Never" />
    <disable_collisions link1="right_jaw" link2="left_jaw" reason="Never" />
</robot>